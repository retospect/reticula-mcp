# Copy to .env (which git ignores) and fill in.

# Release to run, as published on PyPI.
RETICULA_VERSION=0.1.0

# Password of the database user. Generate one: openssl rand -hex 24
RETICULA_DB_PASSWORD=

# The https address people and assistants use to reach this instance, without a
# trailing slash. Sign-in through a connector needs it. Leave empty for
# local-only use on http://127.0.0.1:8787.
RETICULA_PUBLIC_URL=

# Host port on 127.0.0.1.
RETICULA_PORT=8787

# open or closed.
RETICULA_SIGNUP=open
RETICULA_SIGNUP_RATE=5/hour

# auto, hash or fastembed.
RETICULA_EMBEDDER=auto

# Peers whose X-Forwarded-For header is believed, as IPs or CIDRs separated by
# commas. With a tunnel on the docker host this is the docker network's gateway.
RETICULA_TRUSTED_PROXIES=
