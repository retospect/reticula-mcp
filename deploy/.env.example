# Copy to .env (which git ignores) and fill in.

# Release to run, as published on PyPI.
RETICULA_VERSION=0.4.3

# Password of the database role the server connects as, `reticula`, which has
# no superuser rights. Generate one: openssl rand -hex 24
RETICULA_DB_PASSWORD=

# Password of the database superuser `reticula_admin`, for the operator only;
# the server never sees it. Generate another one: openssl rand -hex 24
RETICULA_DB_ADMIN_PASSWORD=

# The https address people and assistants use to reach this instance, without a
# trailing slash. Sign-in through a connector needs it. Leave empty for
# local-only use: the server then answers as http://127.0.0.1:<RETICULA_PORT>.
# Tokens issued at sign-in are bound to this address. Change it and every
# connected assistant has to connect again.
RETICULA_PUBLIC_URL=

# Host port on 127.0.0.1.
RETICULA_PORT=8787

# open or closed.
RETICULA_SIGNUP=open
# Accounts created per hour and client address.
RETICULA_SIGNUP_RATE=5/hour
# OAuth client registrations per hour and client address.
RETICULA_REGISTER_RATE=20/hour
# Writes (put, edit, link, share, delete) per hour and account.
RETICULA_WRITE_RATE=600/hour
# Days the server keeps each person's own log of their tool calls (time,
# connection, tool, ok or error code, short id of their own note). 0 turns
# the log off. Old days are dropped as whole tables, not deleted row by row.
#RETICULA_ACTIVITY_DAYS=30

# auto, hash or fastembed.
RETICULA_EMBEDDER=auto
# Model of the fastembed embedder. The model is built into the image, at a
# pinned revision, and the running server downloads nothing. Changing this
# means rebuilding: docker compose up -d --build. Only the models named here
# can be built in; any other name stops the build. A changed model gets its own
# vectors and index; docs/operating.md, "Change the model", says what happens.
# BAAI/bge-small-en-v1.5 for a small machine, mixedbread-ai/mxbai-embed-large-v1
# for more paraphrases at three times the cost; see docs/operating.md, Choose a
# model. sentence-transformers/all-MiniLM-L6-v2 can be built in too; it has
# not been measured for this server.
#RETICULA_EMBED_MODEL=BAAI/bge-base-en-v1.5

# Peers whose X-Forwarded-For header is believed, as IPs or CIDRs separated by
# commas. Empty trusts nobody. With an https RETICULA_PUBLIC_URL the server does
# not start with this empty: set an address, or the word none to trust nobody on
# purpose (every client then shares one rate-limit bucket).
# With a tunnel or reverse proxy that runs on this
# machine, forwards to 127.0.0.1:<RETICULA_PORT> and sets X-Forwarded-For, the
# value is the gateway of the compose network: 172.31.88.1
# Use none when the tunnel forwards plain TCP and sets no such header.
# docs/operating.md has the reasons and a way to check the result.
RETICULA_TRUSTED_PROXIES=

# Hosts an assistant's connector returns to after sign-in. The sign-in page
# warns when a connection would hand access to any other host.
RETICULA_KNOWN_CLIENTS=claude.ai,claude.com

# Memory limit of the server container. 2g fits the default model with room
# for `reticula-mcp reindex`, which loads the model a second time in the same
# container. A larger model needs more; docs/operating.md, Choose a model.
#RETICULA_APP_MEMORY=2g

# Subnet of the compose network. Change it only when it collides with a
# network you already have; the gateway is then its first address.
#RETICULA_SUBNET=172.31.88.0/24
